{
  "name": "reservme",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "docker compose up -d postgres && vitest run --coverage",
    "db:migrate": "tsx --env-file=.env.development.local scripts/migrate.ts",
    "db:migrate:neon": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env.development.local scripts/seed.ts",
    "admin:grant": "tsx --env-file=.env.development.local scripts/grant-admin.ts",
    "admin:grant:neon": "tsx --env-file=.env.local scripts/grant-admin.ts",
    "test:admin": "tsx --env-file=.env.development.local scripts/test-admin.ts",
    "test:onboarding": "tsx --env-file=.env.development.local scripts/test-onboarding.ts",
    "worker": "tsx --env-file=.env.development.local scripts/worker.ts",
    "test:jobs": "tsx --env-file=.env.development.local scripts/test-jobs.ts",
    "db:backup": "sh scripts/backup.sh",
    "db:restore": "sh scripts/restore.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1114.0",
    "@sentry/node": "^10.70.0",
    "better-auth": "^1.6.27",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "nodemailer": "^9.0.5",
    "pg-boss": "^10.4.2",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
