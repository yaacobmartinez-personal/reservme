# ── Two-file setup: local = docker, never Neon ────────────────────
# Local dev and production use different databases, kept strictly apart:
#
#   .env.development.local  → LOCAL. Points at the docker Postgres. Read by
#                             `next dev` AND every local npm script (tests,
#                             db:migrate, db:seed, worker, admin:grant). Already
#                             created; gitignored. This is why `npm run dev`,
#                             `npm run test:*`, and `npm run admin:grant` all
#                             hit docker and never Neon.
#   .env.local              → PRODUCTION. Your Neon DATABASE_URL + real secrets.
#                             Read only by the *:neon scripts (db:migrate:neon,
#                             admin:grant:neon) and a production `next start`.
#                             Never committed.
#
# To touch Neon on purpose: `npm run db:migrate:neon`, `npm run admin:grant:neon`.
# The template below is for .env.local — fill it with your real production config.

# ── Database ──────────────────────────────────────────────────────
# Matches docker-compose.yml. Host port is 5433 to stay clear of a local
# Local Postgres (docker-compose.yml), on 5433 to avoid a local 5432.
DATABASE_URL="postgresql://reservme:reservme_dev_password@localhost:5433/reservme"
# Production (Neon): use the connection string from the Neon dashboard, which
# includes ?sslmode=require. The pooled endpoint is fine — the booking engine's
# advisory locks are transaction-scoped, so they survive transaction pooling.
#   DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# ── Hosts ─────────────────────────────────────────────────────────
# The apex serves marketing and the public booking pages (reservme.pro/katipunan).
# The app subdomain serves auth and the owner dashboard.
NEXT_PUBLIC_APEX_HOST="localhost:3000"
NEXT_PUBLIC_APP_HOST="app.localhost:3000"
NEXT_PUBLIC_ADMIN_HOST="admin.localhost:3000"
NEXT_PUBLIC_PROTOCOL="http"

# In production:
#   NEXT_PUBLIC_APEX_HOST="reservme.pro"
#   NEXT_PUBLIC_APP_HOST="app.reservme.pro"
#   NEXT_PUBLIC_ADMIN_HOST="admin.reservme.pro"
#   NEXT_PUBLIC_PROTOCOL="https"

# ── Auth ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-secret-replace-me-with-32-bytes"
BETTER_AUTH_URL="http://app.localhost:3000"

# ── Email (optional) ─────────────────────────────────────────────
# Without these, emails are logged to the worker console instead of sent,
# so everything runs unconfigured. Get a key at resend.com.
RESEND_API_KEY=""
EMAIL_FROM="ReservMe <bookings@reservme.pro>"

# ── Abuse protection (optional) ──────────────────────────────────
# Cloudflare Turnstile. Unset = booking is protected by rate limiting only.
# When set, the booking form must also render the widget (site key).
TURNSTILE_SECRET=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ── Image storage (optional) ─────────────────────────────────────
# Cloudflare R2 for court photos, logos, cover images and QR codes. Without
# these, images are stored inline as size-capped data URLs in the DB (works,
# but bloats rows). Set all five and uploads go to R2, storing only the public
# URL. R2_PUBLIC_URL is the bucket's public domain — its r2.dev URL or a custom
# domain (e.g. https://images.reservme.pro).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# ── Observability (optional) ─────────────────────────────────────
# Without a DSN, errors are logged as structured JSON only. With one,
# they are also forwarded to Sentry. Point an uptime monitor at
# /api/healthz (returns 503 if the database is down).
SENTRY_DSN=""
